; FFDRealms -- original RPG prototype, not affiliated with Jagex.
; Import this file with Godot 4.3 or newer (Standard / GDScript).
config_version=5

[application]
config/name="FFDRealms - Multiplayer Test"
config/description="An original, skill-based fantasy RPG prototype by FFDevelopment."
config/version="0.4.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="FFDRealms_Prototype"
config/icon="res://icon.svg"

[autoload]
Game="*res://scripts/game_state.gd"
Network="*res://scripts/network_service.gd"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/min_width=1024
window/size/min_height=640
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.16, 0.23, 0.26, 1)

[physics]
common/physics_ticks_per_second=60

; Appearance-only toggles. Restart the game after changing. No save reset required.
[ffdrealms]
network/server_url="http://127.0.0.1:8765"
visuals/world_textures=true
visuals/normal_maps=true
